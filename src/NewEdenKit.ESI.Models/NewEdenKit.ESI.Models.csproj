<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Shipped inside the NewEdenKit.ESI package, not as a package of its own. -->
    <IsPackable>false</IsPackable>
    <Description>ESI data transfer objects, enums, unions and the source-generated JSON context for NewEdenKit.ESI.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Generated services pass EsiJsonContext type info to the factory; the context itself stays internal. -->
    <InternalsVisibleTo Include="NewEdenKit.ESI" />
  </ItemGroup>

</Project>
