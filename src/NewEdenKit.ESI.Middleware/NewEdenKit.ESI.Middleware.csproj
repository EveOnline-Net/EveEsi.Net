  <ItemGroup>
    <ProjectReference Include="../NewEdenKit.ESI.Abstractions/NewEdenKit.ESI.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- For AddEsiInMemoryCacheStore(). -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

</Project>
