<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Request factory, middleware pipeline and HTTP execution for NewEdenKit.ESI.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../NewEdenKit.ESI.Abstractions/NewEdenKit.ESI.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The DI package wires up the internal factory; both always ship with the same version. -->
    <InternalsVisibleTo Include="NewEdenKit.ESI" />
    <!-- The generated-service tests drive every service method through the real factory and route table. -->
    <InternalsVisibleTo Include="NewEdenKit.ESI.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

</Project>
