<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="../../src/NewEdenKit.ESI/NewEdenKit.ESI.csproj" />
    <!-- Embedded in the NewEdenKit.ESI package (PrivateAssets there), so they don't flow through the project reference;
         a package consumer gets them from the package. -->
    <ProjectReference Include="../../src/NewEdenKit.ESI.Models/NewEdenKit.ESI.Models.csproj" />
    <ProjectReference Include="../../src/NewEdenKit.ESI.Routes/NewEdenKit.ESI.Routes.csproj" />
    <ProjectReference Include="../../src/NewEdenKit.ESI.Client/NewEdenKit.ESI.Client.csproj" />
    <ProjectReference Include="../../src/NewEdenKit.ESI.Middleware/NewEdenKit.ESI.Middleware.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- CI builds map source paths to /_/ (deterministic builds), so the usage-guide test locates docs/ this way. -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ProjectDirectory</_Parameter1>
      <_Parameter2>$(MSBuildProjectDirectory)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
