<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="../../tools/NewEdenKit.ESI.Generator/NewEdenKit.ESI.Generator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Expected generator output: compared as text, never compiled here. -->
    <Compile Remove="Snapshots/**" />
    <None Include="Snapshots/**" />
    <None Include="Fixtures/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- CI builds map source paths to /_/ (deterministic builds), so [CallerFilePath] can't locate these files. -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ProjectDirectory</_Parameter1>
      <_Parameter2>$(MSBuildProjectDirectory)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
